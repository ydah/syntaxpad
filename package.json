{
  "name": "syntaxpad-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Lossless Bison, Yacc, and Lrama grammar tooling for VS Code",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "benchmark": "npm run benchmark --workspace @syntaxpad/core",
    "build": "tsc -b && node scripts/build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package": "npm run check && node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
